+class QAndroidRasterBackingStore : public QRhiBackingStore
+{
+public:
+    using QRhiBackingStore::QRhiBackingStore;
+
+    void flush(QWindow *flushedWindow, const QRegion &region, const QPoint &offset) override
+    {
+        // QBackingStore::flush supplies native pixel coordinates, whereas
+        // QRhiBackingStore forwards them to rhiFlush, which scales logical
+        // coordinates by the source DPR. Undo the first conversion so dirty
+        // regions and native child offsets are not scaled twice. Round the
+        // region outwards to retain every dirty pixel at fractional scales.
+        QRhiBackingStore::flush(flushedWindow,
+                QHighDpi::fromNativeLocalExposedRegion(region, window()),
+                QHighDpi::fromNativeLocalPosition(offset, window()));
+    }
+};
 
